# Stream B strict candidate: LYNN_LINEAR_ATTN_CONV_BACKEND=triton_inplace only.
#
# Per the 2026-05-18 hand-off: B 单 strict candidate, no stacking. The
# AMBER profile (Codex's qwen36_candidate_env_amber_sharedgate_convinplace.env)
# combines this with LYNN_SHARED_EXPERT_GATE_BACKEND=triton and is known
# RED on P37. This candidate isolates triton_inplace alone to test
# whether the conv-update kernel boundary collapse can carry strict P37.
#
# Stream B promotion bar (FIXED, 2026-05-18 hand-off):
#   P37 3/3 exact (strict numerical greedy)
#   P25 512 decode TPS >= 113 TPS
#   P26 full-attn OR linear block 总耗时 >= 5% drop vs safe default
#   ALL THREE simultaneously. P37 drift = closed, not packaged as AMBER.
#
# Expected on R6000:
#   P37 exact: pending (hypothesis: GREEN — triton_inplace alone may not
#     produce greedy drift; if it does, this candidate is closed)
#   structured (40 hard set): pending (expected 40/40)
#   P25 512 decode TPS: pending (target >= 113 to qualify as B deliverable)
#   P26 linear block: pending (target >= 5% drop vs safe default)
#   decision: pending — strict 三项 must all clear.
#
# Run with:
#
#   CANDIDATE_NAME=linear_attn_conv_inplace_strict \
#   CANDIDATE_ENV_FILE=scripts/qwen36_candidate_env_linear_attn_conv_inplace_strict.env \
#   scripts/r6000_qwen36_candidate_promotion_gate.sh
#
# Apply Stream C report card to the result:
#
#   scripts/stream_b_promotion_report_card.py \
#     --gate-json reports/promotion-gates/linear_attn_conv_inplace_strict.json \
#     --safe-default-tps 107
#
# Per the hand-off, AMBER is owned by Stream C and requires structured
# 70/70 hard set + P25 >= 118. This file does not chase AMBER — it is a
# strict B candidate or it closes.
LYNN_LINEAR_ATTN_CONV_BACKEND=triton_inplace

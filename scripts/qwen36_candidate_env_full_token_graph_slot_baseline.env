# Stream B baseline candidate: existing full-token graph slot (capture-per-token).
#
# Enables the existing LYNN_FULL_TOKEN_GRAPH_SLOT path on the
# Qwen3.6-35B-A3B W4A16 NVFP4 serving route. The per-token capture
# cost is known to dominate (P13 docstring documents this), so the
# expected R6000 decision is research_artifact_only (slower than safe
# default, structured + P37 may still pass).
#
# Why measure it anyway:
#
# * the actual TPS delta vs safe-default quantifies how much capture
#   overhead the whole-token graph slot pays today;
# * that number bounds the upside of the per-layer reuse pool
#   described in docs/STREAM_B_FULL_ATTN_LAYER_GRAPH_REUSE_SPEC_20260518.md
#   — the per-layer pool saves capture cost by recapturing at bucket
#   boundaries (default 256 tokens) instead of every step.
#
# Pre-condition: LYNN_ROUTER_TOPK_SORTED=1 must be on (the
# full-token graph slot wiring checks this at startup).
#
# Promotion-gate status on R6000, 2026-05-18: NOT YET RUN
#   P37 exact-greedy: pending (expected GREEN — graph replay is
#     byte-identical to eager forward by construction)
#   hard structured gate: pending (expected GREEN 40/40)
#   P25 512-token decode TPS: pending (expected LOW — capture-per-token
#     overhead dominates)
#   decision: pending (likely research_artifact_only by P25 floor;
#     baseline number is the actual deliverable)
#
# Run with:
#
#   CANDIDATE_NAME=full_token_graph_slot_baseline \
#   CANDIDATE_ENV_FILE=scripts/qwen36_candidate_env_full_token_graph_slot_baseline.env \
#   scripts/r6000_qwen36_candidate_promotion_gate.sh
#
# Then feed the resulting JSON into:
#
#   scripts/stream_b_promotion_report_card.py \
#     --gate-json reports/promotion-gates/full_token_graph_slot_baseline.json \
#     --safe-default-tps 107
#
# Per the 2026-05-18 hand-off, no candidate ships on microbench TPS
# alone — every status update must report P37 exact + hard structured
# pass + P25 512 decode TPS together. This candidate's value is the
# baseline number, not a promote.
LYNN_FULL_TOKEN_GRAPH_SLOT=1
LYNN_ROUTER_TOPK_SORTED=1

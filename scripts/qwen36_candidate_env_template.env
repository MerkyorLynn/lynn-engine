# Template for R6000 Qwen3.6-35B-A3B W4A16 candidate gates.
#
# Use with:
#
#   CANDIDATE_NAME=my_candidate \
#   CANDIDATE_ENV_FILE=scripts/qwen36_candidate_env_template.env \
#   scripts/r6000_qwen36_candidate_promotion_gate.sh
#
# Only include deltas from the safe default route. The gate script already pins
# the default Qwen3.6 W4A16 serving env before applying candidate overrides.
#
# Example:
# LYNN_EXAMPLE_BACKEND=triton
